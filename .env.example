# Agentic Investment Research Platform — Environment Configuration
# Copy this file to .env and fill in your values.

# Tushare API token (required for real data; not needed for --provider mock)
# Get one at https://tushare.pro/document/1?doc_id=39
TUSHARE_TOKEN=

# Anthropic API key — enables LLM-driven dynamic planning
# (plan_for_goal) and LLM telemetry. Without it, the Planner uses the
# deterministic rule-based decomposition.
ANTHROPIC_API_KEY=

# Data provider: mock (default) | tushare
AGENT_PROVIDER=mock

# Analysis defaults
AGENT_TOP_K=5
AGENT_DATA_START=20240101
AGENT_DATA_END=20251231

# RAG knowledge layer (pass --reuse-memory to enable per run)
AGENT_REUSE_MEMORY=false
